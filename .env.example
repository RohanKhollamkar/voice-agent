# Copy to .env and fill in. Never commit .env.

# Speech-to-text (Sarvam, real-time)
SARVAM_API_KEY=

# Optional. codemix writes Hindi words in Devanagari and English words in Latin;
# translit writes everything in Latin; transcribe is Sarvam's default
# SARVAM_STT_MODE=codemix

# Speech (ElevenLabs Flash v2.5)
ELEVENLABS_API_KEY=
# Optional. Defaults to the premade voice "Sarah". Library voices need a paid plan
# ELEVENLABS_VOICE_ID=

# Language models (NVIDIA API, key from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
BOT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Outcome sink: each call's outcome is POSTed here (e.g. a webhook.site URL)
WEBHOOK_URL=

# Set to false to disable the code-level OTP gate and reproduce the
# "balance without OTP" failure on demand
ENFORCE_OTP=true

# Stamped on every outcome
BOT_VERSION=v2

# sarvam | elevenlabs (the ElevenLabs free plan has a monthly character quota)
TTS_PROVIDER=sarvam
# Optional voice turn-taking settings (defaults in config.py; see docs/results/latency.md)
# SARVAM_STT_SILENCE_MS=700
# SARVAM_STT_STREAM_TYPE=balanced
# STT_ENDPOINTING=vad
# VOICE_ACK_AFTER_SECONDS=1.5

# Optional, for Sarvam speech
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_VOICE=ishita_en_customer
