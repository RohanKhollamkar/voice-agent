# Copy to .env and fill in the keys. Never commit .env.
# Every setting config.py reads is listed here. Commented lines show the default and
# can be left as they are.

# --- Keys and endpoints (required) ---

# Speech-to-text and speech (Sarvam). Key from dashboard.sarvam.ai
SARVAM_API_KEY=
# Language models (NVIDIA API). Key from build.nvidia.com
NVIDIA_API_KEY=
# Each call's outcome is POSTed here (e.g. a webhook.site URL). Empty: not posted,
# still written to runs/outcomes/
WEBHOOK_URL=
# Only needed with TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# --- Bot ---

# The version stamped on outcomes and used when none is given: v1 | v2 | v2.1
BOT_VERSION=v2.1
# false disables the code-level OTP gate, to reproduce "balance without OTP" on demand
ENFORCE_OTP=true

# --- Models (NVIDIA API IDs) ---

# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# The bot
# BOT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Used when the bot model times out or errors
# BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Reads the outcome off the transcript when the bot never recorded one
# EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Evals only: the judge, and the simulated customer in persona scenarios
# JUDGE_MODEL=moonshotai/kimi-k3.1-pro
# CUSTOMER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Speech-to-text (Sarvam, real-time) ---

# SARVAM_STT_MODEL=saaras:v3-realtime
# codemix: Hindi in Devanagari, English in Latin. Also transcribe | translit | verbatim | translate
# SARVAM_STT_MODE=codemix
# A fixed language: auto-detect turned background noise into Bengali text
# SARVAM_STT_LANGUAGE=hi-IN

# --- Speech ---

# sarvam | elevenlabs (ElevenLabs' free plan has a monthly character quota)
TTS_PROVIDER=sarvam
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_VOICE=ishita_en_customer
# ELEVENLABS_MODEL=eleven_flash_v2_5
# The premade voice "Sarah". Library voices need a paid plan
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Voice turn-taking (see docs/results/latency.md) ---

# vad: Sarvam ends the turn. manual: the local VAD ends it and tells Sarvam
# STT_ENDPOINTING=vad
# fast | balanced
# SARVAM_STT_STREAM_TYPE=balanced
# Silence before Sarvam ends the customer's turn; 300-500 split codes read with pauses
# SARVAM_STT_SILENCE_MS=700
# Local voice detection: silence to end speech, confidence, minimum volume, start time
# VAD_STOP_SECS=0.2
# VAD_CONFIDENCE=0.8
# VAD_MIN_VOLUME=0.7
# VAD_START_SECS=0.3
# Manual endpointing only: how long the customer may pause inside a turn
# USER_SPEECH_TIMEOUT=0.6
# A transcript with fewer real words than this is dropped as noise (digits and short
# answers such as "yes" always pass)
# NOISE_MIN_WORDS=2
# Words the customer must say to interrupt the bot (yes/no and digits interrupt at once)
# BARGE_IN_MIN_WORDS=2
# After an interruption, wait this long for the rest of the customer's turn
# AFTER_INTERRUPTION_WAIT_SECONDS=1.0
# Say "One moment." if the bot has not answered within this many seconds (0: off)
# VOICE_ACK_AFTER_SECONDS=1.5
