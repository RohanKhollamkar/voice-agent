# Copy to .env and fill in. Never commit .env.

# Speech-to-text (Sarvam, real-time)
SARVAM_API_KEY=

# Optional. codemix writes Hindi words in Devanagari and English words in Latin;
# translit writes everything in Latin; transcribe is Sarvam's default
# SARVAM_STT_MODE=codemix

# Speech (ElevenLabs Flash v2.5)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Language models (OpenRouter)
OPENROUTER_API_KEY=
BOT_MODEL=google/gemma-4-31b-it:free
BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Outcome sink: each call's outcome is POSTed here (e.g. a webhook.site URL)
WEBHOOK_URL=

# Set to false to disable the code-level OTP gate and reproduce the
# "balance without OTP" failure on demand
ENFORCE_OTP=true

# Stamped on every outcome
BOT_VERSION=v2

# elevenlabs | sarvam
TTS_PROVIDER=elevenlabs
